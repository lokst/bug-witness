# Nosana deployment serving the reasoning model.
# Copy to .env and fill in the URL from your own deployment overview.
# The endpoint is unauthenticated and billed per second, so treat the URL as a
# secret and tear the deployment down when you are finished with it.
NOSANA_BASE_URL=
NOSANA_MODEL=qwen3.6:27b

# Only needed if the deployment is configured to require a bearer token.
NOSANA_API_KEY=

# Daytona sandbox execution.
DAYTONA_API_KEY=
DAYTONA_API_URL=https://app.daytona.io/api
DAYTONA_TARGET=us
